# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email destination for contact form submissions
CONTACT_EMAIL_TO=seu_email@bitcraft.com

# Feature flags
# Toggle each section on/off without code changes. Default OFF.
# Accepted truthy values: 1, true, yes, on. Falsy: 0, false, no, off.
# Vercel: set in project env settings, redeploy to apply.

NEXT_PUBLIC_FEATURE_LOGO_CLOUD=false
NEXT_PUBLIC_FEATURE_TESTIMONIALS=false
NEXT_PUBLIC_FEATURE_CASE_STUDIES=false
NEXT_PUBLIC_FEATURE_TEAM=false
NEXT_PUBLIC_FEATURE_PROCESS_TIMELINE=false
NEXT_PUBLIC_FEATURE_ENGAGEMENT_MODELS=false
NEXT_PUBLIC_FEATURE_BUDGET_TIERS=false
NEXT_PUBLIC_FEATURE_SPECIALIST=false
NEXT_PUBLIC_FEATURE_BLOG=false
